<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F5F5">
    <TextView android:id="@+id/tvTituloPainel" android:layout_width="0dp" android:layout_height="wrap_content"
        android:background="#1A1A2E" android:text="Painel Administrativo" android:textColor="#FFFFFF"
        android:textSize="20sp" android:textStyle="bold" android:gravity="center" android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <Button android:id="@+id/btnGerenciarUsuarios" android:layout_width="0dp" android:layout_height="60dp"
        android:layout_margin="16dp" android:text="👤  Gerenciar Usuários" android:textSize="16sp"
        android:backgroundTint="#4A90D9"
        app:layout_constraintTop_toBottomOf="@+id/tvTituloPainel" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <Button android:id="@+id/btnGerenciarAdmins" android:layout_width="0dp" android:layout_height="60dp"
        android:layout_margin="16dp" android:text="🛡️  Gerenciar Admins" android:textSize="16sp"
        android:backgroundTint="#2ECC71"
        app:layout_constraintTop_toBottomOf="@+id/btnGerenciarUsuarios" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <Button android:id="@+id/btnGerenciarPedidos" android:layout_width="0dp" android:layout_height="60dp"
        android:layout_margin="16dp" android:text="📦  Gerenciar Pedidos" android:textSize="16sp"
        android:backgroundTint="#E67E22"
        app:layout_constraintTop_toBottomOf="@+id/btnGerenciarAdmins" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
