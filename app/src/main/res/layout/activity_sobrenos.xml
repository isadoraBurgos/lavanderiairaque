<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:paddingHorizontal="20dp"
                android:background="#FFFFFF">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:adjustViewBounds="true"
                    android:src="@drawable/logoo" />

                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/hamburger" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sobre nós"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#162E58"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="25dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="220dp"
                    android:layout_weight="1"
                    android:scaleType="centerCrop"
                    android:src="@drawable/maquina"
                    android:layout_marginEnd="15dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Nossa História: 45 Anos de Dedicação e Especialidade"
                        android:textColor="#162E58"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tudo começou aos 14 anos, quando dei meus primeiros passos como ajudante em uma lavanderia no Campo Belo. O que era um trabalho de juventude tornou-se uma paixão e um ofício para a vida toda. Após 12 anos de dedicação, o destino trouxe um desafio: a lavanderia onde eu trabalhava foi vendida. Foi então que ouvi do meu antigo patrão as palavras que mudariam tudo: É hora de você ter o seu próprio negócio"
                        android:textColor="#000000"
                        android:textSize="11sp"
                        android:lineSpacingExtra="3dp"
                        android:paddingBottom="1dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Com o apoio fundamental de um amigo italiano e muita coragem, comecei a minha jornada. Naquela época, contava apenas com um carro e duas máquinas, mas carregava comigo uma experiência valiosa."
                android:textColor="#162E58"
                android:textSize="13sp"
                android:layout_margin="20dp"
                android:gravity="start"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="25dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pouco tempo depois, mudei a nossa sede para a Avenida Santa Catarina, onde estamos estabelecidos há 38 anos. Ao longo de mais de quatro décadas, evoluímos com a tecnologia, mas nunca perdemos o toque artesanal. Hoje, a Lavanderia e Tinturaria Iraque é referência absoluta na região, sendo especialista no cuidado com tapetes e roupas executivas."
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:gravity="end"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginEnd="15dp" />

                <ImageView
                    android:layout_width="5dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    android:scaleType="centerCrop"
                    android:src="@drawable/caixas" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="30dp">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/dono"
                    android:layout_marginEnd="15dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="“Faça bem\nfeito para não\nfazer duas\nvezes”"
                    android:textColor="#162E58"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:gravity="start"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E0E0E0"
                android:padding="20dp"
                android:gravity="center">
                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/logoo"
                    android:alpha="0.6"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Direitos reservados à Isabella Avelino, Isadora Burgos e Pedro William"
                    android:textSize="8sp"
                    android:textColor="#808080"
                    android:layout_marginTop="5dp"
                    android:gravity="center" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_whatsapp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_launcher_background"
        app:backgroundTint="#FFFFFF"
        app:fabSize="normal"
        app:elevation="6dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>